# Copy to .env for local development. Never commit real secrets.
APP_NAME=MyMusic AI API
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./mymusic_dev.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Music generation engine. Keep "unconfigured" until ACE-Step is installed.
MUSIC_MODEL_BACKEND=unconfigured
ACE_STEP_BASE_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_TIMEOUT_SECONDS=900
ACE_STEP_POLL_SECONDS=2
DEFAULT_GENERATION_DURATION_SECONDS=30
AUDIO_STORAGE_DIR=./audio_storage
